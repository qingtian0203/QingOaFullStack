<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络请求权限（访问本地 FastAPI 后台） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GPS 定位权限（打卡功能需要） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/qingoa_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/qingoa_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.APP_QingOA"
        android:usesCleartextTraffic="true"
        tools:targetApi="28">

        <!-- 启动入口：SplashActivity 负责 Token 校验路由 -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.APP_QingOA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 登录页 -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 主页（含底部导航） -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- v1.5A：考勤打卡页（上/下班双卡） -->
        <activity
            android:name=".ui.punch.PunchCardActivity"
            android:exported="false" />

        <!-- v1.5A：打卡记录列表页 -->
        <activity
            android:name=".ui.punch.PunchRecordListActivity"
            android:exported="false" />

        <!-- v1.5A：打卡详情页 -->
        <activity
            android:name=".ui.punch.PunchRecordDetailActivity"
            android:exported="false" />

        <!-- v1.5A：通知详情页（由 HomeFragment 公告列表点击进入，不依赖菜单 enabled） -->
        <activity
            android:name=".ui.home.NoticeDetailActivity"
            android:exported="false" />

        <!-- v1.5B：OKR 列表、详情、创建与 KR 进度更新 -->
        <activity
            android:name=".ui.okr.OkrListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.okr.OkrDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.okr.OkrCreateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
